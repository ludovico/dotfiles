#!/usr/bin/env bash
# Remove symlinks created by the previous dotbot setup so stow can take over.
# Only removes symlinks whose target points into this repo. Real files left alone.
# Dry-run by default; pass --apply to actually remove.
set -e
REPO="$(cd "$(dirname "$0")" && pwd)"

TARGETS=(
  "$HOME/.config/ccstatusline"
  "$HOME/.claude"
  "$HOME/.config/nvim"
  "$HOME/.config/direnv/direnvrc"
  "$HOME/.config/gitignore"
  "$HOME/.config/ghostty"
  "$HOME/.config/mutt"
  "$HOME/.config/newsboat"
  "$HOME/.notmuch-config"
  "$HOME/.config/vdirsyncer/config"
  "$HOME/.config/msmtp/config"
  "$HOME/.config/jiratui/config.yaml"
  "$HOME/.config/vdirsyncer/get-username.sh"
  "$HOME/.config/vdirsyncer/get-password.sh"
  "$HOME/.config/khard"
  "$HOME/.mbsyncrc"
  "$HOME/.taskrc"
  "$HOME/.dotfiles"
  "$HOME/.tmux.conf"
  "$HOME/.aerospace.toml"
  "$HOME/.tmux.conf.local"
  "$HOME/.tmux"
  "$HOME/.zshrc"
  "$HOME/.zprofile"
  "$HOME/.zshenv"
  "$HOME/bin"
  "$HOME/.bunches"
  "$HOME/.xinitrc"
)

apply=0
[ "$1" = "--apply" ] && apply=1

count=0
for t in "${TARGETS[@]}"; do
  if [ -L "$t" ]; then
    dest=$(readlink "$t")
    case "$dest" in
      "$REPO"|"$REPO"/*)
        echo "rm $t  ->  $dest"
        [ $apply -eq 1 ] && rm "$t"
        count=$((count + 1))
        ;;
    esac
  fi
done

echo "---"
if [ $apply -eq 1 ]; then
  echo "Removed $count symlinks."
else
  echo "$count symlinks would be removed. Pass --apply to actually remove."
fi
